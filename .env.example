# Copy this file to .env and fill in the values.
# Never commit .env. It's listed in .gitignore.
# For Coolify, enter the same names as environment variables in the resource settings.

# LiveKit server (the same key pair the LiveKit server was configured with)
LIVEKIT_URL=wss://livekit.<your-domain>
LIVEKIT_API_KEY=<your-livekit-api-key>
LIVEKIT_API_SECRET=<your-livekit-api-secret>

# Speech to text (Deepgram)
DEEPGRAM_API_KEY=<your-deepgram-key>

# LLM (OpenRouter)
OPENROUTER_API_KEY=<your-openrouter-key>

# Text to speech (Fish Audio)
FISH_API_KEY=<your-fish-key>

# Optional: IPs or ranges allowed to reach the SIP trunk, comma-separated.
# Used by setup_sip.py when creating a trunk. Leave empty to allow any address.
SIP_ALLOWED_ADDRESSES=

# Control app: where Sage reads its settings (optional; Sage uses defaults if unset)
SETTINGS_URL=https://<control-domain>/api/internal/settings
# Must match INTERNAL_TOKEN in the control app
INTERNAL_TOKEN=<same-long-random-string-as-control-app>
