# Copy to .env for local runs. In Coolify, enter the same names as environment variables.
# Never commit .env.

# Login for the web UI (single account)
CONTROL_USERNAME=<your-username>
CONTROL_PASSWORD=<your-password>

# Signs the login session cookie. Use a long random value.
SESSION_SECRET=<long-random-string>

# Token that Sage uses to read its settings. Must match the value set on Sage.
INTERNAL_TOKEN=<long-random-string>

# LiveKit server (same key pair as the LiveKit server)
LIVEKIT_URL=wss://livekit.<your-domain>
LIVEKIT_API_KEY=<your-livekit-api-key>
LIVEKIT_API_SECRET=<your-livekit-api-secret>

# Optional: where the SQLite database is stored. Defaults to ./data/control.db
# DB_PATH=/data/control.db
